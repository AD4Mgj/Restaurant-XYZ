<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="kul.example.controller.WalletController"
            prefWidth="1100.0" prefHeight="700.0"
            styleClass="root-bg"
            stylesheets="@/styles/app.css">

    <!-- TOPBAR jak w całej apce -->
    <top>
        <HBox styleClass="topbar">
            <Button text="←"
                    styleClass="hamburger-btn"
                    onAction="#onBackClick"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="PORTFEL" styleClass="topbar-title"/>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>
    </top>

    <!-- CONTENT -->
    <center>
        <VBox spacing="16" alignment="CENTER" styleClass="wallet-wrap">

            <VBox spacing="6" alignment="CENTER" styleClass="wallet-card">
                <Label text="Stan konta" styleClass="wallet-subtitle"/>
                <Label fx:id="balanceLabel" styleClass="wallet-balance"/>
            </VBox>

            <TextField fx:id="amountField"
                       promptText="Kwota (np. 25.50)"
                       styleClass="wallet-field"/>

            <HBox spacing="12" alignment="CENTER">
                <Button text="Dodaj środki"
                        styleClass="btn-primary"
                        onAction="#onDepositClick"/>

                <Button text="Odejmij środki"
                        styleClass="btn-outline"
                        onAction="#onWithdrawClick"/>
            </HBox>

            <Label fx:id="errorLabel" styleClass="error-text"/>
        </VBox>
    </center>

</BorderPane>