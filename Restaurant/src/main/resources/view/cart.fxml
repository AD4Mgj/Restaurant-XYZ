<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="kul.example.controller.CartController"
            stylesheets="@/styles/app.css">

    <!-- TOP BAR -->
    <top>
        <HBox styleClass="topbar" alignment="CENTER_LEFT" spacing="12">
            <padding>
                <Insets top="18" right="24" bottom="18" left="24"/>
            </padding>

            <Label text="RESTAURACJA" styleClass="topbar-title"/>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>
    </top>

    <!-- CONTENT -->
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" styleClass="page-scroll">
            <content>
                <VBox spacing="18" styleClass="page" alignment="TOP_CENTER">
                    <padding>
                        <Insets top="18" right="24" bottom="24" left="24"/>
                    </padding>

                    <!-- Header row: back + title -->
                    <HBox alignment="CENTER_LEFT" spacing="14" maxWidth="980">
                        <Button text="←" onAction="#onBack" styleClass="back-btn"/>
                        <Label text="Koszyk" styleClass="cart-title"/>
                    </HBox>

                    <!-- Cards grid -->
                    <FlowPane fx:id="cartItemsPane"
                              hgap="22" vgap="22"
                              prefWrapLength="980"
                              maxWidth="980"
                              styleClass="cart-grid"/>

                    <!-- Divider -->
                    <Separator styleClass="cart-divider" maxWidth="980"/>

                    <!-- Bottom summary + actions -->
                    <HBox alignment="CENTER_RIGHT" spacing="18" maxWidth="980" styleClass="cart-bottom">
                        <Region HBox.hgrow="ALWAYS"/>

                        <HBox alignment="CENTER_RIGHT" spacing="10">
                            <Label text="Podsumowanie:" styleClass="cart-summary-label"/>
                            <Label fx:id="totalAmountLabel" text="0.00 zł" styleClass="cart-summary-amount"/>
                        </HBox>

                        <HBox spacing="14" alignment="CENTER_RIGHT">
                            <!-- Na razie podpinasz pod dotychczasowy flow zamówienia -->
                            <Button text="Przejdź do kasy"
                                    onAction="#onCheckoutClick"
                                    styleClass="btn-primary"/>
                            <Button text="Wyczyść koszyk"
                                    onAction="#onClearCartClick"
                                    styleClass="btn-clear-outline"/>
                        </HBox>
                    </HBox>

                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>