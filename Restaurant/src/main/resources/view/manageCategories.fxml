<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="kul.example.controller.ManageCategoriesController"
            prefWidth="500" prefHeight="400">

    <top>
        <Label text="Zarządzanie kategoriami"
               style="-fx-font-size: 20px; -fx-font-weight: bold;"
               BorderPane.alignment="CENTER"/>
<!--               padding="20"-->

    </top>

    <center>
        <VBox spacing="15" alignment="CENTER">

            <ListView fx:id="categoryList"
                      prefWidth="300"
                      prefHeight="200"/>

            <HBox spacing="10" alignment="CENTER">
                <TextField fx:id="newCategoryField"
                           promptText="Nowa kategoria"
                           prefWidth="180"/>
                <Button text="Dodaj" onAction="#onAddCategory"/>
            </HBox>

            <HBox spacing="10" alignment="CENTER">
                <Button text="Usuń wybraną"
                        prefWidth="140"
                        onAction="#onDeleteCategory"/>

                <Button text="Powrót"
                        prefWidth="140"
                        onAction="#onBack"/>
            </HBox>

            <Label fx:id="messageLabel" textFill="green"/>

        </VBox>
    </center>

</BorderPane>