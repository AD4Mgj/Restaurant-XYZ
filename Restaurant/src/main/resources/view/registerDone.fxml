<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="kul.example.controller.RegisterController"
            prefWidth="1100.0" prefHeight="700.0"
            styleClass="root-bg"
            stylesheets="@/styles/app.css">

    <top>
        <HBox styleClass="topbar">
            <Label text="RESTAURACJA" styleClass="topbar-title"/>
        </HBox>
    </top>

    <center>
        <StackPane>
            <VBox styleClass="form-wrap" maxWidth="520">

                <HBox alignment="CENTER_LEFT" maxWidth="520">
                    <Button text="←" onAction="#onBackToRegisterName" styleClass="back-btn"/>
                </HBox>

                <Label text="✓" styleClass="success-icon"/>

                <Label text="Gotowe! Konto zostało pomyślnie utworzone"
                       styleClass="form-title"
                       wrapText="true"
                       maxWidth="520"
                       alignment="CENTER"/>

                <Button text="Dalej"
                        maxWidth="340"
                        styleClass="btn-primary"
                        onAction="#finishRegistration"/>

            </VBox>
        </StackPane>
    </center>

</BorderPane>
