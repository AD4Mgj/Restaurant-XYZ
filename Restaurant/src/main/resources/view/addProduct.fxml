<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="kul.example.controller.AddProductController"
            stylesheets="@/styles/app.css"
            styleClass="dialog-root">

    <center>
        <VBox spacing="14" alignment="TOP_CENTER" styleClass="dialog-card" maxWidth="520">
            <padding>
                <Insets top="22" right="26" bottom="22" left="26"/>
            </padding>

            <HBox alignment="CENTER_LEFT">
                <Label text="Dodaj informacje" styleClass="dialog-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="✕" onAction="#onCancel" styleClass="icon-btn"/>
            </HBox>

            <StackPane fx:id="imagePicker"
                       styleClass="image-picker"
                       onMouseClicked="#onChooseImage">

                <!-- PODGLĄD ZDJĘCIA (domyślnie pusty) -->
                <ImageView fx:id="previewImage"
                           fitWidth="300"
                           fitHeight="170"
                           preserveRatio="true"
                           smooth="true"/>

                <!-- RAMKA + PLUS (widoczna tylko gdy NIE ma zdjęcia) -->
                <StackPane fx:id="emptyState" styleClass="image-empty">
                    <Label fx:id="plusLabel" text="+" styleClass="image-plus"/>
                </StackPane>

                <!-- KRZYŻYK NA ZDJĘCIU (widoczny tylko gdy jest zdjęcie) -->
                <Button fx:id="removeImageBtn"
                        text="✕"
                        onAction="#onRemoveImage"
                        styleClass="image-remove-btn"
                        visible="false"
                        managed="false"
                        StackPane.alignment="TOP_RIGHT"/>
            </StackPane>

            <VBox spacing="6" maxWidth="420">
                <Label text="Nazwa" styleClass="field-label"/>
                <TextField fx:id="nameField" prefWidth="420" maxWidth="420" styleClass="field"/>
            </VBox>

            <VBox spacing="6" maxWidth="420">
                <Label text="Cena" styleClass="field-label"/>
                <TextField fx:id="priceField" prefWidth="420" maxWidth="420" styleClass="field"/>
            </VBox>

            <VBox spacing="6" maxWidth="420">
                <Label text="Kategoria" styleClass="field-label"/>
                <ComboBox fx:id="categoryCombo" prefWidth="420" maxWidth="420" styleClass="field"/>
            </VBox>

            <Label fx:id="messageLabel" wrapText="true" styleClass="error-text"/>

            <Button text="Dodaj danie"
                    maxWidth="420"
                    styleClass="btn-primary"
                    onAction="#onAddProduct"/>

            <Button text="Anuluj"
                    maxWidth="420"
                    styleClass="btn-link"
                    onAction="#onCancel"/>

        </VBox>
    </center>

</BorderPane>
