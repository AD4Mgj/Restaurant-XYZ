<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="kul.example.controller.RegisterController"
            prefWidth="1100.0" prefHeight="700.0"
            styleClass="root-bg"
            stylesheets="@/styles/app.css">

    <top>
        <HBox styleClass="topbar">
            <Label text="RESTAURACJA" styleClass="topbar-title"/>
        </HBox>
    </top>

    <center>
        <StackPane>
            <VBox styleClass="form-wrap" maxWidth="380">

                <HBox alignment="CENTER_LEFT" maxWidth="380">
                    <Button text="←" onAction="#onBackToRegisterEmail" styleClass="back-btn"/>
                </HBox>

                <Label text="Ustaw hasło do konta" styleClass="form-title" wrapText="true"/>

                <PasswordField fx:id="passwordField"
                               promptText="Hasło"
                               maxWidth="340"
                               styleClass="field"/>

                <Label text="Min. 6 znaków, 1 cyfra, 1 mała i 1 duża litera."
                       styleClass="form-subtitle"
                       wrapText="true"
                       maxWidth="340"/>

                <Label fx:id="passwordErrorLabel"
                       styleClass="error-text"
                       wrapText="true"
                       maxWidth="340"/>

                <Button text="Dalej"
                        maxWidth="340"
                        styleClass="btn-primary"
                        onAction="#goToName"/>

            </VBox>
        </StackPane>
    </center>

</BorderPane>
