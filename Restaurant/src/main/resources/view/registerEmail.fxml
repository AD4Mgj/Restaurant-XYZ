<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="kul.example.controller.RegisterController"
            prefWidth="1100.0" prefHeight="700.0"
            styleClass="root-bg"
            stylesheets="@/styles/app.css">

    <top>
        <HBox styleClass="topbar">
            <Label text="RESTAURACJA" styleClass="topbar-title"/>
        </HBox>
    </top>

    <center>
        <StackPane>
            <VBox styleClass="form-wrap" maxWidth="380">

                <HBox alignment="CENTER_LEFT" maxWidth="380">
                    <Button text="←" onAction="#onBackToWelcome" styleClass="back-btn"/>
                </HBox>

                <Label text="Jaki jest Twój adres e-mail?" styleClass="form-title" wrapText="true"/>

                <TextField fx:id="emailField"
                           promptText="Email"
                           maxWidth="340"
                           styleClass="field"/>

                <Label fx:id="emailErrorLabel"
                       styleClass="error-text"
                       wrapText="true"
                       maxWidth="340"/>

                <!-- TERAZ PRZECHODZIMY OD RAZU DO HASŁA -->
                <Button text="Dalej"
                        maxWidth="340"
                        styleClass="btn-primary"
                        onAction="#goToPassword"/>

            </VBox>
        </StackPane>
    </center>

</BorderPane>
