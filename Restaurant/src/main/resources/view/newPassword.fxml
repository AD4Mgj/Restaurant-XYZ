<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="kul.example.controller.ResetPasswordController"
            prefHeight="400.0" prefWidth="600.0">

    <center>
        <VBox alignment="CENTER" spacing="10">

            <Label text="Ustaw nowe hasło"/>

            <PasswordField fx:id="newPasswordField" promptText="Nowe hasło"/>

            <Button text="Zapisz" onAction="#onPasswordChange"/>

            <Label fx:id="messageLabel" textFill="green"/>

        </VBox>
    </center>

</BorderPane>