<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="kul.example.controller.RegisterController"
            prefHeight="400.0" prefWidth="600.0">

    <children>
        <VBox spacing="15" layoutX="150" layoutY="80">
            <children>

                <Label text="Rejestracja" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

                <TextField fx:id="emailField" promptText="Email"/>
                <PasswordField fx:id="passwordField" promptText="Hasło"/>
                <PasswordField fx:id="confirmPasswordField" promptText="Powtórz hasło"/>

                <Button text="Zarejestruj"
                        onAction="#handleRegister"
                        prefWidth="200"/>

                <Label fx:id="messageLabel" textFill="red"/>
            </children>
        </VBox>
    </children>

</AnchorPane>