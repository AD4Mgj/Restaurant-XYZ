<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="kul.example.controller.OrderHistoryController"
            prefWidth="1100" prefHeight="700"
            styleClass="root-bg"
            stylesheets="@/styles/app.css">

    <top>
        <HBox styleClass="topbar">
            <Button text="←"
                    styleClass="hamburger-btn"
                    onAction="#onBackClick"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Label text="HISTORIA ZAMÓWIEŃ"
                   styleClass="topbar-title"/>

            <Region HBox.hgrow="ALWAYS"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="20" alignment="CENTER" styleClass="history-wrap">

            <VBox spacing="10" alignment="CENTER" styleClass="history-card">

                <Label text="Twoje zamówienia"
                       styleClass="wallet-subtitle"/>

                <TableView fx:id="orderTable"
                           prefHeight="500"
                           styleClass="history-table">

                    <columns>
                        <TableColumn fx:id="idColumn"
                                     text="ID"
                                     prefWidth="60"/>

                        <TableColumn fx:id="addressColumn"
                                     text="Adres dostawy"
                                     prefWidth="250"/>

                        <TableColumn fx:id="totalColumn"
                                     text="Kwota"
                                     prefWidth="120"/>

                        <TableColumn fx:id="dateColumn"
                                     text="Data"
                                     prefWidth="200"/>

                        <TableColumn fx:id="productsColumn"
                                     text="Produkty"
                                     prefWidth="350"/>
                    </columns>

                </TableView>
            </VBox>

        </VBox>
    </center>

</BorderPane>