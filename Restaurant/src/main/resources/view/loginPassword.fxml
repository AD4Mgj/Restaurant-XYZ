<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="kul.example.controller.PasswordController"
            prefWidth="1100.0" prefHeight="700.0"
            styleClass="root-bg"
            stylesheets="@/styles/app.css">

    <top>
        <HBox styleClass="topbar">
            <Label text="RESTAURACJA" styleClass="topbar-title"/>
        </HBox>
    </top>

    <center>
        <StackPane>
            <VBox styleClass="form-wrap" maxWidth="380">

                <HBox alignment="CENTER_LEFT" maxWidth="380">
                    <Button text="←" onAction="#onBackClick" styleClass="back-btn"/>
                </HBox>

                <Label text="Wprowadź hasło do konta" styleClass="form-title" wrapText="true"/>

                <PasswordField fx:id="passwordField"
                               promptText="Hasło"
                               maxWidth="340"
                               styleClass="field"/>

                <Label fx:id="messageLabel" styleClass="error-text" wrapText="true"/>

                <Hyperlink text="Zresetuj hasło"
                           fx:id="resetLink"
                           visible="false"
                           styleClass="link"
                           onAction="#onResetPasswordClick"/>

                <Button text="Dalej"
                        maxWidth="340"
                        styleClass="btn-primary"
                        onAction="#onLoginClick"/>

            </VBox>
        </StackPane>
    </center>

</BorderPane>
