<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="kul.example.controller.WelcomeController"
            prefWidth="1100.0" prefHeight="700.0"
            styleClass="root-bg"
            stylesheets="@/styles/app.css">

    <!-- GÓRNY PASEK -->
    <top>
        <HBox styleClass="topbar">
            <Label text="RESTAURACJA" styleClass="topbar-title"/>
        </HBox>
    </top>

    <!-- ŚRODEK -->
    <center>
        <HBox alignment="CENTER" spacing="110" styleClass="main-content">

            <!-- LEWA STRONA: slider -->
            <VBox alignment="CENTER" spacing="16">
                <StackPane styleClass="image-card">
                    <ImageView fx:id="sliderImageView"
                               fitWidth="420"
                               fitHeight="320"
                               preserveRatio="true"
                               smooth="true"/>
                </StackPane>

                <!-- KROPKI -->
                <HBox fx:id="dotsBox" alignment="CENTER" spacing="10"/>
            </VBox>

            <!-- PRAWA STRONA: tekst + tagi + przyciski -->
            <VBox alignment="CENTER" spacing="18" prefWidth="420">

                <Label text="Twoje ulubione dania w jednym miejscu"
                       wrapText="true"
                       styleClass="hero-title"
                       maxWidth="420"
                       alignment="CENTER"/>

                <FlowPane alignment="CENTER" hgap="12" vgap="12">
                    <Label text="Sprawdzone receptury" styleClass="tag"/>
                    <Label text="Szybka obsługa" styleClass="tag"/>
                    <Label text="Z miłości do jedzenia" styleClass="tag"/>
                    <Label text="Świeże składniki" styleClass="tag"/>
                </FlowPane>

                <VBox spacing="12" alignment="CENTER" maxWidth="340">
                    <Button text="Zaloguj się"
                            maxWidth="340"
                            styleClass="btn-primary"
                            onAction="#onLoginClick"/>

                    <Button text="Zarejestruj się"
                            maxWidth="340"
                            styleClass="btn-outline"
                            onAction="#onRegisterClick"/>
                </VBox>

            </VBox>
        </HBox>
    </center>

</BorderPane>